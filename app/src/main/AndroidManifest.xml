<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 悬浮窗锁定方式：加一个 0×0 的覆盖层窗口给系统提供固定 screenOrientation -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 用于「关闭电池优化」按钮（把本应用从省电清理里摘出来，降低无障碍服务被关掉的概率） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 悬浮窗方式锁定期间在通知栏显示一条常驻提示（0×0 悬浮窗本身看不见，这是唯一的可见反馈） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 开机自启动：重启手机后按「开机自启动」开关恢复运行（界面开关控制，见 BootReceiver） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 后台守护：用前台服务（常驻通知）的方式提高进程优先级，被系统杀掉后自动重启 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+ 起 specialUse 类型的前台服务要单独声明权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- 桌面（HOME）应用常常没有自己的 MAIN/LAUNCHER 图标，只声明 HOME 的话会被包可见性藏起来，
             resolveActivity(HOME) 就会返回 null —— 这样"回到桌面"永远识别不出来，锁定不会解除。 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- android 11+ 的包可见性：需要判断 Shizuku 是否安装 -->
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppRotate">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 开机自启动：重启后按界面开关决定是否恢复运行。
             exported=true 才能收到系统的隐式广播（BOOT_COMPLETED 是受保护广播，只有系统能发）。
             MY_PACKAGE_REPLACED 覆盖应用更新后的场景；QUICKBOOT_POWERON 是部分厂商 ROM 的"快速开机"广播。 -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 后台守护：常驻一条低优先级通知的前台服务。
             锁定方向不属于媒体/定位等标准前台场景，用 specialUse 类型；Android 14+ 要求
             在 <property> 里写明子类型用途，否则启动时系统会抛异常。 -->
        <service
            android:name=".RotationGuardService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the rotation lock process alive after boot and re-applies the global rotation mode" />
        </service>

        <service
            android:name=".RotationAccessibilityService"
            android:exported="true"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Shizuku：应用内"无线 adb"通道，用来以 shell 身份执行一次性的 am compat 覆盖 -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
